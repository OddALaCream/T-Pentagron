# Copia este archivo como .env.local y ajusta los valores.

# Fuente de datos: "mock" (datos de demostración, no requiere backend) o "api" (FastAPI).
NEXT_PUBLIC_DATA_MODE=api

# URL base del backend FastAPI (solo se usa cuando NEXT_PUBLIC_DATA_MODE=api).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Tiempo máximo de espera de las peticiones al backend, en milisegundos.
NEXT_PUBLIC_API_TIMEOUT_MS=15000

# Integración futura de Google Maps en la vista regional (opcional, vacío = desactivado).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Mapa base satelital de la vista regional mediante NASA GIBS (no requiere credenciales).
# Pon "false" para trabajar sin conexión o sin peticiones externas.
NEXT_PUBLIC_ENABLE_GIBS=true

# Teselas del globo al acercarse (mapa de referencia, no imagen de la fecha elegida).
NEXT_PUBLIC_ENABLE_GLOBE_TILES=true
